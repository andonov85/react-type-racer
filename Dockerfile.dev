# Use an official Node.js runtime as a parent image
FROM node:16-alpine

# Set the working directory to /home/node/app
WORKDIR /home/node/app

# Copy the package.json file to the container
COPY package*.json ./

# Install the app dependencies
RUN npm install

# Copy the local source code directory to the container
COPY . .

RUN mkdir -p /home/node/app/node_modules/.cache && \
    chown -R node:node /home/node/app/node_modules/.cache

# Expose port 3000 for the React app to listen on
EXPOSE 3000

# Start the React app using the "start" command in package.json
USER node
CMD ["npm", "start"]